@model SocialCharge.Models.SocialActivity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1>Delete Activity</h1>
        <p class="text-muted">Confirm that you want to delete this activity.</p>
    </div>

    <div class="alert alert-danger">
        คุณแน่ใจไหมว่าต้องการลบกิจกรรมนี้? เมื่อลบแล้วจะไม่สามารถกู้คืนได้
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">@Model.Title</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">วันที่และเวลา</dt>
                <dd class="col-sm-9">@Model.ActivityDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">หมวดหมู่</dt>
                <dd class="col-sm-9">@Model.Category?.Name</dd>

                <dt class="col-sm-3">พลังงานก่อน</dt>
                <dd class="col-sm-9">@Model.EnergyBeforeText</dd>

                <dt class="col-sm-3">พลังงานหลัง</dt>
                <dd class="col-sm-9">@Model.EnergyAfterText</dd>

                <dt class="col-sm-3">เปลี่ยนแปลง</dt>
                <dd class="col-sm-9">@Model.EnergyChangeText</dd>

                <dt class="col-sm-3">สถานะ</dt>
                <dd class="col-sm-9">
                    @if (Model.EnergyStatus == "Charged")
                    {
                        <span class="badge bg-success">@Model.EnergyStatus</span>
                    }
                    else if (Model.EnergyStatus == "Slightly Charged")
                    {
                        <span class="badge bg-primary">@Model.EnergyStatus</span>
                    }
                    else if (Model.EnergyStatus == "Neutral")
                    {
                        <span class="badge bg-secondary">@Model.EnergyStatus</span>
                    }
                    else if (Model.EnergyStatus == "Slightly Drained")
                    {
                        <span class="badge bg-warning text-dark">@Model.EnergyStatus</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Model.EnergyStatus</span>
                    }
                </dd>

                <dt class="col-sm-3">ความสนุก</dt>
                <dd class="col-sm-9">@Model.EnjoymentText</dd>

                <dt class="col-sm-3">จำนวนคนที่พบ</dt>
                <dd class="col-sm-9">@Model.PeopleCount</dd>

                <dt class="col-sm-3">หมายเหตุ</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <span class="text-muted">ไม่มีหมายเหตุ</span>
                    }
                    else
                    {
                        @Model.Note
                    }
                </dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>