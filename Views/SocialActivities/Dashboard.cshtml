@model SocialCharge.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Dashboard</h1>
            <p class="text-muted mb-0">Summary of how your activities affect your energy.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Activities
        </a>
    </div>

    @if (Model.TotalActivities == 0)
    {
        <div class="empty-state text-center">
            <div class="empty-state-icon">📊</div>
            <h4>ยังไม่มีข้อมูลสำหรับ Dashboard</h4>
            <p class="text-muted">
                เพิ่มกิจกรรมก่อน แล้วระบบจะสรุปพลังงานของคุณให้อัตโนมัติ
            </p>

            <a asp-action="Create" class="btn btn-primary">
                + Add Activity
            </a>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="stat-card card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="stat-icon">📝</div>
                        <h6 class="text-muted">Total Activities</h6>
                        <h2>@Model.TotalActivities</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="stat-card card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="stat-icon">🔋</div>
                        <h6 class="text-muted">Avg. Energy Before</h6>
                        <h2>@Model.AverageEnergyBefore</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="stat-card card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="stat-icon">⚡</div>
                        <h6 class="text-muted">Avg. Energy After</h6>
                        <h2>@Model.AverageEnergyAfter</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="stat-card card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="stat-icon">📈</div>
                        <h6 class="text-muted">Avg. Change</h6>
                        <h2 class="@(Model.AverageEnergyChange > 0 ? "text-success" : Model.AverageEnergyChange < 0 ? "text-danger" : "text-secondary")">
                            @(Model.AverageEnergyChange > 0 ? $"+{Model.AverageEnergyChange}" : Model.AverageEnergyChange.ToString())
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-success text-white">
                        Most Charged Activity
                    </div>

                    <div class="card-body">
                        @if (Model.MostChargedActivity != null)
                        {
                            <h5>@Model.MostChargedActivity.Title</h5>
                            <p class="mb-1">
                                Category:
                                <span class="badge bg-light text-dark border">
                                    @Model.MostChargedActivity.Category?.Name
                                </span>
                            </p>
                            <p class="mb-1">
                                Change:
                                <span class="@Model.MostChargedActivity.EnergyChangeDisplayClass">
                                    @Model.MostChargedActivity.EnergyChangeText
                                </span>
                            </p>
                            <p class="mb-0">
                                Status:
                                <span class="@Model.MostChargedActivity.EnergyStatusBadgeClass">
                                    @Model.MostChargedActivity.EnergyStatus
                                </span>
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-danger text-white">
                        Most Drained Activity
                    </div>

                    <div class="card-body">
                        @if (Model.MostDrainedActivity != null)
                        {
                            <h5>@Model.MostDrainedActivity.Title</h5>
                            <p class="mb-1">
                                Category:
                                <span class="badge bg-light text-dark border">
                                    @Model.MostDrainedActivity.Category?.Name
                                </span>
                            </p>
                            <p class="mb-1">
                                Change:
                                <span class="@Model.MostDrainedActivity.EnergyChangeDisplayClass">
                                    @Model.MostDrainedActivity.EnergyChangeText
                                </span>
                            </p>
                            <p class="mb-0">
                                Status:
                                <span class="@Model.MostDrainedActivity.EnergyStatusBadgeClass">
                                    @Model.MostDrainedActivity.EnergyStatus
                                </span>
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header">
                Energy Status Summary
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Count</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td><span class="badge bg-success">Charged</span></td>
                                <td>@Model.ChargedCount</td>
                            </tr>

                            <tr>
                                <td><span class="badge bg-primary">Slightly Charged</span></td>
                                <td>@Model.SlightlyChargedCount</td>
                            </tr>

                            <tr>
                                <td><span class="badge bg-secondary">Neutral</span></td>
                                <td>@Model.NeutralCount</td>
                            </tr>

                            <tr>
                                <td><span class="badge bg-warning text-dark">Slightly Drained</span></td>
                                <td>@Model.SlightlyDrainedCount</td>
                            </tr>

                            <tr>
                                <td><span class="badge bg-danger">Drained</span></td>
                                <td>@Model.DrainedCount</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>