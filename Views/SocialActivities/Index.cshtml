@model IEnumerable<SocialCharge.Models.SocialActivity>

@{
    ViewData["Title"] = "Social Activities";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Social Activities</h1>
            <p class="text-muted">Track how each activity changes your energy.</p>
        </div>

        <a class="btn btn-primary" asp-controller="SocialActivities" asp-action="Create">
            + Add Activity
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            ยังไม่มีรายการกิจกรรม ลองเพิ่มกิจกรรมแรกของคุณในขั้นตอนถัดไป
        </div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>วันที่</th>
                    <th>กิจกรรม</th>
                    <th>หมวดหมู่</th>
                    <th>ก่อน</th>
                    <th>หลัง</th>
                    <th>เปลี่ยนแปลง</th>
                    <th>สถานะ</th>
                    <th>ความสนุก</th>
                    <th>จำนวนคน</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ActivityDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Title</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.EnergyBeforeText</td>
                        <td>@item.EnergyAfterText</td>
                        <td>@item.EnergyChangeText</td>
                        <td>
                            @if (item.EnergyStatus == "Charged")
                            {
                                <span class="badge bg-success">@item.EnergyStatus</span>
                            }
                            else if (item.EnergyStatus == "Slightly Charged")
                            {
                                <span class="badge bg-primary">@item.EnergyStatus</span>
                            }
                            else if (item.EnergyStatus == "Neutral")
                            {
                                <span class="badge bg-secondary">@item.EnergyStatus</span>
                            }
                            else if (item.EnergyStatus == "Slightly Drained")
                            {
                                <span class="badge bg-warning text-dark">@item.EnergyStatus</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@item.EnergyStatus</span>
                            }
                        </td>
                        <td>@item.EnjoymentText</td>
                        <td>@item.PeopleCount</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                    Details
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>