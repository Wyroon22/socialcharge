@model IEnumerable<SocialCharge.Models.SocialActivity>

@{
    ViewData["Title"] = "Social Activities";
}

<div class="container mt-4">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Social Activities</h1>
            <p class="text-muted mb-0">Track how each activity changes your energy.</p>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-controller="SocialActivities" asp-action="Dashboard">
                📊 Dashboard
            </a>

            <a class="btn btn-primary" asp-controller="SocialActivities" asp-action="Create">
                + Add Activity
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state text-center">
            <div class="empty-state-icon">🔋</div>
            <h4>ยังไม่มีรายการกิจกรรม</h4>
            <p class="text-muted">
                เริ่มบันทึกกิจกรรมแรกของคุณ เพื่อดูว่ากิจกรรมนั้นชาร์จพลังหรือดูดพลัง
            </p>

            <a class="btn btn-primary" asp-controller="SocialActivities" asp-action="Create">
                + Add First Activity
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>วันที่</th>
                                <th>กิจกรรม</th>
                                <th>หมวดหมู่</th>
                                <th>ก่อน</th>
                                <th>หลัง</th>
                                <th>เปลี่ยนแปลง</th>
                                <th>สถานะ</th>
                                <th>ความสนุก</th>
                                <th>จำนวนคน</th>
                                <th class="text-end">จัดการ</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted">
                                        @item.ActivityDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <strong>@item.Title</strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @item.Category?.Name
                                        </span>
                                    </td>

                                    <td>@item.EnergyBeforeText</td>

                                    <td>@item.EnergyAfterText</td>

                                    <td class="@item.EnergyChangeDisplayClass">
                                        @item.EnergyChangeText
                                    </td>

                                    <td>
                                        <span class="@item.EnergyStatusBadgeClass">
                                            @item.EnergyStatus
                                        </span>
                                    </td>

                                    <td>@item.EnjoymentText</td>

                                    <td>@item.PeopleCount</td>

                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">
                                                Details
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>