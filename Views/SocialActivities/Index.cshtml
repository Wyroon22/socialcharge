@model IEnumerable<SocialCharge.Models.SocialActivity>

@{
    ViewData["Title"] = "Social Activities";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Social Activities</h1>
            <p class="text-muted">Track how each activity changes your energy.</p>
        </div>

        <a class="btn btn-primary" href="#">
            + Add Activity
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            ยังไม่มีรายการกิจกรรม ลองเพิ่มกิจกรรมแรกของคุณในขั้นตอนถัดไป
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>วันที่</th>
                    <th>กิจกรรม</th>
                    <th>หมวดหมู่</th>
                    <th>ก่อน</th>
                    <th>หลัง</th>
                    <th>เปลี่ยนแปลง</th>
                    <th>สถานะ</th>
                    <th>ความสนุก</th>
                    <th>จำนวนคน</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ActivityDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Title</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.EnergyBefore</td>
                        <td>@item.EnergyAfter</td>
                        <td>@item.EnergyChange</td>
                        <td>@item.EnergyStatus</td>
                        <td>@item.EnjoymentScore</td>
                        <td>@item.PeopleCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>